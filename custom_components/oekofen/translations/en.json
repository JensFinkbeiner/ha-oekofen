{
  "config": {
    "step": {
      "user": {
        "title": "Connect ÖkoFEN Pellematic",
        "description": "Enable the JSON interface on the boiler's touch panel first (General settings → Network → JSON mode \"On\", not \"compatible\").",
        "data": {
          "host": "Host",
          "port": "JSON port",
          "password": "JSON password"
        },
        "data_description": {
          "host": "IP address or host name of the boiler in your network.",
          "port": "Port of the JSON interface, usually 4321.",
          "password": "Password of the JSON interface. This is not the password of the ÖkoFEN web portal."
        }
      },
      "reauth_confirm": {
        "title": "New JSON password",
        "description": "The boiler rejected the JSON password. Enter the current password of the JSON interface.",
        "data": {
          "password": "JSON password"
        },
        "data_description": {
          "password": "Password of the JSON interface. This is not the password of the ÖkoFEN web portal."
        }
      },
      "reconfigure": {
        "title": "Change connection",
        "description": "Change the address or port of the boiler. The JSON password stays the same.",
        "data": {
          "host": "Host",
          "port": "JSON port"
        },
        "data_description": {
          "host": "IP address or host name of the boiler in your network.",
          "port": "Port of the JSON interface, usually 4321."
        }
      }
    },
    "error": {
      "cannot_connect": "The boiler cannot be reached. Check host, port and that the JSON interface is enabled.",
      "invalid_auth": "The boiler did not return data. Check the JSON password.",
      "invalid_answer": "The boiler returned an answer that could not be read.",
      "no_boiler": "The answer contains no boiler data (section pe1 missing).",
      "unknown": "Unexpected error, see the log.",
      "busy": "The boiler is busy (another program is reading it). Try again in a few seconds."
    },
    "abort": {
      "already_configured": "This boiler is already configured.",
      "reauth_successful": "The JSON password was updated.",
      "reconfigure_successful": "The connection was updated."
    }
  },
